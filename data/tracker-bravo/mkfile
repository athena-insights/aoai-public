^([0-9]+)/$ROLLUPS/(stats|nets|weights|wave)\.tsv:R: \1/$ROLLUPS/responses.tsv \1/$DICTS/items.tsv \1/$DICTS/options.tsv \1/$DICTS/netdefs.tsv \1/$DICTS/recodes.tsv rollups.R
	u Rscript rollups.R $stem1

pooled/([0-9]+)\+([0-9]+)/$DICTS/([a-z_]+\.tsv):R: \1/$DICTS/\3 \2/$DICTS/\3
	mkdir -p pooled/$stem1+$stem2/$DICTS
	if(! cmp -s $stem1/$DICTS/$stem3 $stem2/$DICTS/$stem3) { echo pooled/$stem1+$stem2: $DICTS/$stem3 differs between the members >[1=2]; exit 1 }
	cp $stem2/$DICTS/$stem3 $target

pooled/([0-9]+)\+([0-9]+)/$ROLLUPS/(responses|stats|nets|weights|wave)\.tsv:R: \1/$ROLLUPS/responses.tsv \2/$ROLLUPS/responses.tsv ${POOLDICT:%=pooled/\1+\2/$DICTS/%} rollups.R
	u Rscript rollups.R pooled/$stem1+$stem2 $stem1 $stem2

clean:V:
	for(w in $WAVES) rm -f $w/$ROLLUPS/^(responses.tsv stats.tsv nets.tsv weights.tsv wave.tsv)
	for(p in $POOLS) rm -rf pooled/$p/$ROLLUPS pooled/$p/$DICTS

BUILT=`{for(w in $WAVES) echo $w/$ROLLUPS $w/codebook.tsv; for(p in $POOLS) echo pooled/$p}

