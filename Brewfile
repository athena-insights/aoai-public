brew "go"           # the site's build and the report writer (go.mod)
brew "age"          # decrypts the fonts and the raw deliveries, with the two keys from .env

tap "r-lib/rig"
cask "rig"

brew "resvg"        # `9 mk logos`: outlines and recolors the logo sources
brew "imagemagick"  # `9 mk photos`: crops and sizes the photos' originals
brew "watchexec"    # `9 mk watch`: rebuild and reload on each edit
